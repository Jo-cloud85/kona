# Kona — environment configuration
# Copy to .env.local for development. Never commit a filled-in copy.
# `next dev` / `next start` load .env.local automatically. The CLI does not —
# run it as: node --env-file=.env.local --import tsx src/cli/chat.ts --llm=anthropic
# ---------------------------------------------------------------------------

# --- LLM (conversation) ----------------------------------------------------
# The real Anthropic model is the shipped path. With no key, Kona falls back to
# the deterministic stub (CI / offline). Force either way with KONA_LLM.
ANTHROPIC_API_KEY=
# KONA_LLM=deterministic          # or: anthropic
# KONA_LLM_MODEL=claude-sonnet-5

# --- Persistence + Auth (Supabase) --------------------------------------
# When these are set, Kona uses Supabase Postgres for storage and Supabase Auth
# (magic link) for sign-in, with Row Level Security isolating each user.
#
# When they are UNSET, Kona runs a dev-only in-memory fallback: one local user,
# no auth, state resets on restart. That fallback is refused when
# NODE_ENV=production, so a production deploy MUST set both of these.
#
# Find them in your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# The service-role key is NOT used by the app (RLS + a user-scoped anon client
# are the security boundary). Only the live persistence test suite needs it.

# --- Live persistence tests (optional) --------------------------------
# Point these at a DISPOSABLE Supabase project with supabase/migrations/0001_init.sql
# applied. `npm test` then also runs tests/data/supabase-repository.live.test.ts.
KONA_TEST_SUPABASE_URL=
KONA_TEST_SUPABASE_ANON_KEY=
KONA_TEST_SUPABASE_SERVICE_ROLE=
