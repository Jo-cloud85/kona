# Only needed for the real Anthropic LLM client
# (npm run chat -- --llm=anthropic). The deterministic client needs nothing.
#
# The CLI does not auto-load this file. Either export the vars into your shell,
# or run with Node's loader:  node --env-file=.env --import tsx src/cli/chat.ts --llm=anthropic

# Anthropic Messages API key. Never commit the real value.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-5).
# KONA_LLM_MODEL=claude-sonnet-5

# Optional: default LLM client for the CLI when no --llm flag is passed.
# KONA_LLM=deterministic
